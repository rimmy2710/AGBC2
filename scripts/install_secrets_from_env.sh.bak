#!/usr/bin/env bash
set -e

AGBC2_HOME="${AGBC2_HOME:-$HOME/.agbc2}"
SECRETS_DIR="${AGBC2_SECRETS_DIR:-$AGBC2_HOME/secrets}"
GSPREAD_DIR="${GSPREAD_DIR:-$HOME/.config/gspread}"

mkdir -p "$SECRETS_DIR" "$GSPREAD_DIR"

# Google service account json (base64)
if [ -n "${GSPREAD_SA_JSON_B64:-}" ]; then
  echo "$GSPREAD_SA_JSON_B64" | base64 -d > "$SECRETS_DIR/gspread_service_account.json"
fi

# Telegram session file (base64) - recommended for CI
if [ -n "${TELEGRAM_SESSION_B64:-}" ]; then
  echo "$TELEGRAM_SESSION_B64" | base64 -d > "$SECRETS_DIR/telegram.session"
fi

echo "[AGBC2] secrets installed into $SECRETS_DIR"
