#!/usr/bin/env bash
# NOTE: This file is intended to be SOURCED (.) to set env vars.
# Do NOT enable strict mode here; it can break interactive shell hooks (e.g., rvm).

export PYTHONPATH="${PYTHONPATH:-/workspaces/AGBC2/src}"

# Base directories (portable across Codespace/GitHub Actions/local)
export AGBC2_HOME="${AGBC2_HOME:-$HOME/.agbc2}"
export AGBC2_SECRETS_DIR="${AGBC2_SECRETS_DIR:-$AGBC2_HOME/secrets}"

# Admin config sheet (not secret)
export ADMIN_CONFIG_SHEET_ID="${ADMIN_CONFIG_SHEET_ID:-1LSpeHELAOQw3_kdqcQ9CftWyZ9JZqUGH6EBsmmoEn9w}"
export ADMIN_CONFIG_ENABLED="${ADMIN_CONFIG_ENABLED:-1}"

# Output sheet (not secret)
export GOOGLE_SHEET_ID="${GOOGLE_SHEET_ID:-1LSpeHELAOQw3_kdqcQ9CftWyZ9JZqUGH6EBsmmoEn9w}"
export GOOGLE_SHEET_TAB="${GOOGLE_SHEET_TAB:-AGBC2 – News Draft}"

# GSpread credentials (secret file path)
export GOOGLE_APPLICATION_CREDENTIALS="${GOOGLE_APPLICATION_CREDENTIALS:-$AGBC2_SECRETS_DIR/gspread_service_account.json}"

# Telegram (secrets - DO NOT COMMIT real values)
export TELEGRAM_SESSION_PATH="${TELEGRAM_SESSION_PATH:-$AGBC2_SECRETS_DIR/telegram.session}"
export TELEGRAM_API_ID="${TELEGRAM_API_ID:-30864018}"
export TELEGRAM_API_HASH="${TELEGRAM_API_HASH:-dc97dc8c6734021bb9bf01bba2380426}"

# OpenAI (secret - DO NOT COMMIT real values)
export OPENAI_ENABLED="${OPENAI_ENABLED:-1}"
export OPENAI_MODEL="${OPENAI_MODEL:-gpt-5-nano}"
# export OPENAI_API_KEY="OPENAI_KEY_HERE"

# Safe mode
export LIMIT_PER_CHANNEL="${LIMIT_PER_CHANNEL:-50}"
export STYLE_MAX_EXAMPLES="${STYLE_MAX_EXAMPLES:-3}"
